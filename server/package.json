{
  "name": "server",
  "version": "1.0.0",
  "description": "Node.js API and background workers.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../scripts/run-with-env.mjs .dev.env tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "reprocess": "node ../scripts/run-with-env.mjs .dev.env tsx scripts/reprocess-assets.ts",
    "dev:worker": "node ../scripts/run-with-env.mjs .dev.env tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/s3-request-presigner": "^3.984.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.2.0",
    "bullmq": "^5.69.2",
    "dotenv": "^17.2.3",
    "exif-reader": "^2.0.3",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^6.1.0",
    "file-type": "^21.3.0",
    "jose": "^6.1.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.6",
    "sharp": "^0.34.5",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
